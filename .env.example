SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_REDIRECT_URI=http://localhost:8765/callback
TOKEN_LOOKUP_SECRET=change-me
DATABASE_URL=postgresql://user:pass@host:5432/dbname
